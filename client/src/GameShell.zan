using System;
using System.Collections.Generic;
using System.IO;
using System.Json;
using Game.Foundation;
using Game.Foundation.Gui;

// 跃迁山谷 · PLATFORMER 的外壳：存档（最远关卡 / 累计通关数 / 最佳单关用时 /
// 总分 / 累计死亡）+ 设置（难度 / 音效）+ 设置浮层。
//
// 存档基座（原子写 + 备份回退 + 版本号）与设置逻辑层在公共包
// Game.Foundation 里；这里只留"这个游戏存什么、设置有哪几项"。
public class GameShell {
    GameSaveStore store;
    GameSettings settings;
    SettingsModel model;
    SettingsOverlay overlay;
    int level;      // 最远到达的关卡（1..3）
    int clears;     // 累计通关数
    int bestTime;   // 最佳单关用时（毫秒）
    int score;      // 累计总分
    int deaths;     // 累计死亡数
    int runs;       // 局数（每启动一次 +1）

    public GameShell() {
        string dir = GameShell.SaveDir();
        Directory.CreateDirectory(dir);
        this.store = new GameSaveStore(dir, "platformer", 1);
        this.settings = new GameSettings().At(dir + "/settings.json");
        // 难度：重力、跑速与起跳高度都跟着变（1 轻松 / 2 标准 / 3 硬核）。
        this.settings.AddIntChoice("difficulty", "难度", 2,
            new List<int> { 1, 2, 3 });
        // 音效：关掉后所有事件都不出声（画面与玩法不变）。
        this.settings.AddBool("sound", "音效", true);
        this.settings.Load();
        this.model = new SettingsModel(this.settings);
        this.overlay = new SettingsOverlay(this.model);
        this.overlay.SetTitle("设置");
        this.Load();
    }

    // 存档目录：%LOCALAPPDATA%/Platformer（可用 PLATFORMER_SAVE 环境变量
    // 覆盖，测试脚本靠它把存档落在临时目录里，不污染玩家机器）。
    static string SaveDir() {
        string overridden = Environment.GetEnvironmentVariable("PLATFORMER_SAVE");
        if (overridden != "") { return overridden; }
        string basePath = Environment.GetEnvironmentVariable("LOCALAPPDATA");
        if (basePath == "") { basePath = Directory.GetCurrentDirectory(); }
        return basePath + "/Platformer";
    }

    public SettingsOverlay Overlay() { return this.overlay; }
    public int Level() { return this.level; }
    public int Clears() { return this.clears; }
    public int BestTime() { return this.bestTime; }
    public int Score() { return this.score; }
    public int Deaths() { return this.deaths; }
    public int Runs() { return this.runs; }

    // 当前难度档（1/2/3）——游戏逻辑读它调物理参数。
    public int Difficulty() {
        if (this.settings == null) { return 2; }
        return this.settings.GetInt("difficulty");
    }

    // 音效开关。
    public bool Sound() {
        if (this.settings == null) { return true; }
        return this.settings.GetBool("sound");
    }

    // 读档：没有存档就用默认值，不报错。
    public void Load() {
        JsonValue data = this.store.Load(0);
        if (data == null) {
            this.level = 0; this.clears = 0; this.bestTime = 0;
            this.score = 0; this.deaths = 0; this.runs = 0;
            return;
        }
        this.level = data.Int("level", 0);
        this.clears = data.Int("clears", 0);
        this.bestTime = data.Int("bestTime", 0);
        this.score = data.Int("score", 0);
        this.deaths = data.Int("deaths", 0);
        this.runs = data.Int("runs", 0);
    }

    // 最远关卡：只增不减。
    public void RecordLevel(int lv) {
        if (lv > this.level) { this.level = lv; }
    }

    // 通关一次：累计通关数 +1，最佳单关用时只降不升。
    public void RecordClear(int milliseconds) {
        this.clears = this.clears + 1;
        if (milliseconds > 0 && (this.bestTime == 0 || milliseconds < this.bestTime)) {
            this.bestTime = milliseconds;
        }
    }

    // 累计总分。
    public void AddScore(int points) {
        if (points > 0) { this.score = this.score + points; }
    }

    // 累计死亡数。
    public void RecordDeath() {
        this.deaths = this.deaths + 1;
    }

    // 存档：局数 +1 后落盘。
    public void Save() {
        this.runs = this.runs + 1;
        JsonValue data = JsonValue.NewObject();
        data.PutInt("level", this.level);
        data.PutInt("clears", this.clears);
        data.PutInt("bestTime", this.bestTime);
        data.PutInt("score", this.score);
        data.PutInt("deaths", this.deaths);
        data.PutInt("runs", this.runs);
        this.store.Save(0, data);
    }
}
