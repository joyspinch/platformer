using System;
using System.Collections.Generic;
using System.IO;
using Gui;
using Game.Kit;

// 画面层：视差背景、地形贴图、角色/敌人/晶片位图、HUD、菜单与结算面板。
//
// 贴图来源走 Game.Kit.Assets.Find（磁盘优先）→ 找不到再退回内嵌表
// （发布后资源在 exe 里），再找不到就走纯色绘制，绝不崩。
//
// 两条规矩：
//   颜色一律从 PlatformerPalette 取（同一语义只有一个出处）；
//   朝向一律按 PlatformerFacing 的取帧规则从两帧精灵表里取
//   （引擎运行时不能翻转贴图，方向只能离线烘焙）。
public class PlatformerView {
    public const int DesignW = 1280;
    public const int DesignH = 720;
    // 中景层（远山与松树）的顶边：树冠从这条线往下长。
    public const int MidLayerY = 150;

    // 左上角 HUD 面板的几何。
    public const int HudX = 12;
    public const int HudY = 8;
    public const int HudW = 440;
    public const int HudH = 86;
    // 底部提示条。
    public const int HintH = 34;
    // 九宫格角切片边长（源图像素）：与 ui_board.png / ui_button*.png 对齐。
    public const int BoardCorner = 16;
    public const int ButtonCorner = 14;

    public string bgFar = "";
    public string bgMid = "";
    public string bgNear = "";
    public string playerKey = "";      // 两帧精灵表 144x100（0=朝右 1=朝左）
    public string droneKey = "";       // 两帧精灵表 176x76
    public string shardKey = "";
    public string tileKey = "";
    public string flagKey = "";
    public string boardKey = "";       // 九宫格面板底板
    public string buttonKey = "";      // 按钮底板（常态）
    public string buttonHoverKey = ""; // 按钮底板（悬停）
    public string buttonPrimaryKey = ""; // 按钮底板（主按钮）
    public string shadowKey = "";      // 落地投影
    public string flareKey = "";       // 巡逻兵尾焰（朝向指示）
    public string glowKey = "";        // 角色背后的柔光
    public bool assetsReady;

    // 载入全部贴图。
    public void LoadAssets() {
        this.bgFar = PlatformerView.Asset("assets/bg_far.png");
        this.bgMid = PlatformerView.Asset("assets/bg_mid.png");
        this.bgNear = PlatformerView.Asset("assets/bg_near.png");
        this.playerKey = PlatformerView.Asset("assets/player_sheet.png");
        this.droneKey = PlatformerView.Asset("assets/drone_sheet.png");
        this.shardKey = PlatformerView.Asset("assets/shard.png");
        this.tileKey = PlatformerView.Asset("assets/tile_ground.png");
        this.flagKey = PlatformerView.Asset("assets/flag.png");
        this.boardKey = PlatformerView.Asset("assets/ui_board.png");
        this.buttonKey = PlatformerView.Asset("assets/ui_button.png");
        this.buttonHoverKey = PlatformerView.Asset("assets/ui_button_hover.png");
        this.buttonPrimaryKey = PlatformerView.Asset("assets/ui_button_primary.png");
        this.shadowKey = PlatformerView.Asset("assets/shadow.png");
        this.flareKey = PlatformerView.Asset("assets/flare.png");
        this.glowKey = PlatformerView.Asset("assets/glow.png");
        this.assetsReady = this.playerKey != "" && this.droneKey != "" && this.shardKey != "";
    }

    // 磁盘优先 → 内嵌兜底 → 空串（调用方走纯色兜底）。
    static string Asset(string rel) {
        string p = Assets.Find(rel);
        if (p != null && p != "" && File.Exists(p)) { return p; }
        try {
            if (File.EmbedExists(rel)) {
                byte[] b = File.ReadAllBytes(rel);
                string key = "mem:" + rel;
                Canvas.ImageLoadMem(key, b, b.Length);
                return key;
            }
        } catch (Exception) {
        }
        return "";
    }

    // ---- 视差背景 -----------------------------------------------------

    // 一层视差：裁源矩形取景，随相机按 factor 速度滚动。
    // 取景窗口取源图宽的 3/4（留出 1/4 的滚动余量），源矩形按同一比例
    // 缩到设计宽度——不靠平移两张拼接，免得有竖缝。
    // destY：层的顶边（逻辑像素）；传 -1 表示底边对齐地面线。
    void DrawLayer(Canvas c, string key, int cam, float factor, int destY) {
        if (key == null || key == "") { return; }
        int iw = Canvas.ImageWidth(key);
        int ih = Canvas.ImageHeight(key);
        if (iw <= 1 || ih <= 0) { return; }
        int sw = iw * 3 / 4;
        if (sw < 1) { sw = 1; }
        int sh = ih;
        int maxSx = iw - sw;
        if (maxSx < 0) { maxSx = 0; }
        int sx = (int)((float)cam * factor * (float)sw / (float)PlatformerView.DesignW);
        if (sx > maxSx) { sx = maxSx; }
        if (sx < 0) { sx = 0; }
        int destH = PlatformerView.DesignW * sh / sw;
        int y = destY;
        if (y < 0) { y = PlatformerLevel.GroundY - destH; }
        PlatformerPaint.BlitSrc(c, key, 0, y, PlatformerView.DesignW, destH, sx, 0, sw, sh);
    }

    // ---- 游戏画面 -----------------------------------------------------

    public void DrawGame(Canvas c, PlatformerGame g, int w, int h, PlatformerFx fx) {
        int cam = (int)g.camX;
        // 底色（视差层之间的天）。
        PlatformerPaint.Fill(c, 0, 0, w, h, PlatformerPalette.Sky);
        this.DrawLayer(c, this.bgFar, cam, 0.10f, 0);
        this.DrawLayer(c, this.bgMid, cam, 0.20f, PlatformerView.MidLayerY);
        this.DrawLayer(c, this.bgNear, cam, 0.30f, -1);
        // 地面线以下的深渊（缺口掉下去就是掉进这里）。
        PlatformerPaint.Fill(c, 0, PlatformerLevel.GroundY, w, h - PlatformerLevel.GroundY,
            PlatformerPalette.Abyss);
        // 地形。
        for (int i = 0; i < g.level.solids.Count; i = i + 1) {
            PlatformerSolid s = g.level.solids[i];
            int sx = s.x - cam;
            if (sx > w || sx + s.w < 0) { continue; }
            PlatformerPaint.Fill(c, sx, s.y, s.w, s.h, PlatformerPalette.RockDark);
            PlatformerPaint.Fill(c, sx, s.y + 8, s.w, 6, PlatformerPalette.RockEdge);
            if (this.tileKey != "") {
                for (int tx = 0; tx < s.w; tx = tx + 64) {
                    PlatformerPaint.Blit(c, this.tileKey, sx + tx, s.y, 64, 64);
                }
            }
        }
        // 出口旗。
        int flagX = g.level.exitX - cam - 20;
        if (flagX > -60 && flagX < w + 60) {
            if (this.flagKey != "") {
                PlatformerPaint.Blit(c, this.flagKey, flagX, PlatformerLevel.GroundY - 64, 40, 64);
            } else {
                PlatformerPaint.Fill(c, flagX + 18, PlatformerLevel.GroundY - 64, 4, 64, PlatformerPalette.Amber);
                PlatformerPaint.Fill(c, flagX + 20, PlatformerLevel.GroundY - 60, 26, 18, PlatformerPalette.AmberDeep);
            }
        }
        // 晶片。
        for (int i = 0; i < g.shards.Count; i = i + 1) {
            PlatformerShard s = g.shards[i];
            if (s.taken) { continue; }
            int sx = (int)s.x - cam;
            if (sx < -40 || sx > w + 40) { continue; }
            PlatformerPaint.FillCircle(c, sx + 14, (int)s.y + 18, 14, PlatformerPalette.CrystalGlow);
            if (this.shardKey != "") {
                PlatformerPaint.Blit(c, this.shardKey, sx, (int)s.y, 28, 36);
            } else {
                PlatformerPaint.FillRound(c, sx + 7, (int)s.y + 4, 14, 28, 5, PlatformerPalette.Moss);
            }
        }
        // 巡逻兵（贴图左右对称，靠尾焰标出巡逻方向）。
        for (int i = 0; i < g.enemies.Count; i = i + 1) {
            PlatformerEnemy e = g.enemies[i];
            if (!e.alive) { continue; }
            int sx = (int)e.x - cam;
            if (sx < -60 || sx > w + 60) { continue; }
            this.DrawShadow(c, g, e.x + (float)PlatformerEnemy.W * 0.5f,
                e.y + (float)PlatformerEnemy.H, 36);
            if (this.droneKey != "") {
                PlatformerPaint.BlitSrc(c, this.droneKey, sx, (int)e.y,
                    PlatformerEnemy.W, PlatformerEnemy.H,
                    PlatformerFacing.DroneSrcX(e.facingRight), 0,
                    PlatformerFacing.DroneFrameW, PlatformerFacing.DroneFrameH);
            } else {
                PlatformerPaint.FillRound(c, sx, (int)e.y, 44, 38, 14, PlatformerPalette.Danger);
                PlatformerPaint.FillCircle(c, sx + 22, (int)e.y + 19, 6, PlatformerPalette.DangerSoft);
            }
            this.DrawFacingMark(c, sx, (int)e.y, e.facingRight);
        }
        // 玩家（受伤无敌时闪烁）：朝向决定取哪一帧。
        PlatformerPlayer p = g.player;
        int px = (int)p.x - cam;
        bool blink = p.Invincible() && ((g.demoTimer / 3) % 2 == 0);
        if (!blink) {
            // 背光柔光：把角色从背景里托出来（黄昏天色下尤其需要）。
            if (this.glowKey != "") {
                int gw = PlatformerPlayer.W + 26;
                int gh = PlatformerPlayer.H + 26;
                PlatformerPaint.Blit(c, this.glowKey,
                    px + PlatformerPlayer.W / 2 - gw / 2,
                    (int)p.y + PlatformerPlayer.H / 2 - gh / 2, gw, gh);
            }
            this.DrawShadow(c, g, p.x + (float)PlatformerPlayer.W * 0.5f,
                p.y + (float)PlatformerPlayer.H, 44);
            if (this.playerKey != "") {
                PlatformerPaint.BlitSrc(c, this.playerKey, px, (int)p.y,
                    PlatformerPlayer.W, PlatformerPlayer.H,
                    PlatformerFacing.PlayerSrcX(p.facingRight), 0,
                    PlatformerFacing.PlayerFrameW, PlatformerFacing.PlayerFrameH);
            } else {
                PlatformerPaint.FillRound(c, px, (int)p.y, 36, 50, 8, PlatformerPalette.MossDeep);
                PlatformerPaint.Fill(c, px + 6, (int)p.y + 8, 22, 13, PlatformerPalette.Parchment);
            }
        }
        // 尘土粒子（起跳 / 落地）。
        if (fx != null) { fx.Draw(c, cam); }
        // HUD。
        this.DrawHud(c, g, w, h);
    }

    // 巡逻兵朝向指示：贴图左右对称，靠尾焰（暖橙）标出前进方向。
    void DrawFacingMark(Canvas c, int x, int y, bool facingRight) {
        if (this.flareKey == "") { return; }
        int cy = y + PlatformerEnemy.H / 2;
        int fx = facingRight ? x - 8 : x + PlatformerEnemy.W + 8;
        PlatformerPaint.Blit(c, this.flareKey, fx - 14, cy - 7, 28, 12);
    }

    // 落地投影：软椭圆贴在脚下；腾空时贴在下方地形顶面并随高度缩小。
    void DrawShadow(Canvas c, PlatformerGame g, float cx, float feetY, int w) {
        if (this.shadowKey == "") { return; }
        int ground = this.GroundUnder(g, cx, feetY - 2.0f);
        int sy = (int)feetY;
        float scale = 1.0f;
        if (ground >= 0 && (float)ground < feetY) {
            sy = ground;
            float drop = feetY - (float)ground;
            scale = 1.0f - drop / 260.0f;
            if (scale < 0.4f) { scale = 0.4f; }
        }
        int sw = (int)((float)w * scale);
        if (sw < 6) { sw = 6; }
        int sh = sw / 4;
        // 影子整体压在地面线之下一点：上半截会被近景灌木吃掉，
        // 压低一点才有"踩在地上"的实感。
        PlatformerPaint.Blit(c, this.shadowKey, (int)cx - sw / 2, sy - sh / 2 + 3, sw, sh);
    }

    // (x, feetY) 下方最近的地形顶面（没有则返回 -1）。
    int GroundUnder(PlatformerGame g, float x, float feetY) {
        int best = -1;
        for (int i = 0; i < g.level.solids.Count; i = i + 1) {
            PlatformerSolid s = g.level.solids[i];
            if (x < (float)s.x || x > (float)(s.x + s.w)) { continue; }
            if ((float)s.y < feetY - 1.0f) { continue; }
            if (best < 0 || s.y < best) { best = s.y; }
        }
        return best;
    }

    // 顶部 HUD：关卡名、生命、晶片、用时、分数；底部一条操作提示。
    void DrawHud(Canvas c, PlatformerGame g, int w, int h) {
        // 左上角面板：美术底板（九宫格），没有底板才退回纯色圆角矩形。
        if (this.boardKey != "") {
            PlatformerPaint.NineSlice(c, this.boardKey, PlatformerView.HudX,
                PlatformerView.HudY, PlatformerView.HudW, PlatformerView.HudH,
                PlatformerView.BoardCorner);
        } else {
            PlatformerPaint.FillRound(c, PlatformerView.HudX, PlatformerView.HudY,
                PlatformerView.HudW, PlatformerView.HudH, 10, PlatformerPalette.PanelFill);
            PlatformerPaint.Round(c, PlatformerView.HudX, PlatformerView.HudY,
                PlatformerView.HudW, PlatformerView.HudH, 10, PlatformerPalette.PanelEdge, 2);
        }
        PlatformerPaint.Text(c, "第 " + Convert.ToString(g.levelIndex + 1) + " 关 · " + g.level.name,
            30, 18, 20, PlatformerPalette.Amber);
        PlatformerPaint.Text(c, "生命", 30, 50, 15, PlatformerPalette.Slate);
        for (int i = 0; i < g.lives; i = i + 1) {
            PlatformerPaint.FillRound(c, 74 + i * 24, 48, 18, 18, 5, PlatformerPalette.Danger);
            PlatformerPaint.FillRound(c, 79 + i * 24, 53, 8, 8, 3, PlatformerPalette.DangerSoft);
        }
        PlatformerPaint.Text(c, "晶片 " + Convert.ToString(g.coins), 160, 50, 15, PlatformerPalette.Moss);
        PlatformerPaint.Text(c, "用时 " + PlatformerView.Sec(g.totalTimeMs) + "s", 250, 50, 15, PlatformerPalette.Slate);
        PlatformerPaint.Text(c, "分数 " + Convert.ToString(g.score), 344, 50, 15, PlatformerPalette.Amber);

        // 底部提示条：同一块美术底板 + 弱色文字。
        string hint = "A/D 移动 · 空格跳（空中再按一次 = 二段跳）· Esc 设置";
        int bw = PlatformerPaint.Measure(c, hint, 14) + 32;
        int by = h - PlatformerView.HintH - 10;
        if (this.boardKey != "") {
            PlatformerPaint.NineSlice(c, this.boardKey, PlatformerView.HudX, by, bw,
                PlatformerView.HintH, PlatformerView.BoardCorner);
        } else {
            PlatformerPaint.FillRound(c, PlatformerView.HudX, by, bw, PlatformerView.HintH, 8,
                PlatformerPalette.PanelFill);
        }
        PlatformerPaint.Text(c, hint, PlatformerView.HudX + 16, by + 10, 14, PlatformerPalette.Mist);
    }

    // 秒数格式化（毫秒 → "12.3"）。
    public static string Sec(float ms) {
        int tenths = (int)(ms / 100.0f);
        int whole = tenths / 10;
        int frac = tenths % 10;
        return Convert.ToString(whole) + "." + Convert.ToString(frac);
    }

    // ---- 菜单 ---------------------------------------------------------

    public void DrawMenu(Canvas c, int w, int h, GameShell shell) {
        PlatformerPaint.Fill(c, 0, 0, w, h, PlatformerPalette.Sky);
        this.DrawLayer(c, this.bgFar, 0, 0.10f, 0);
        this.DrawLayer(c, this.bgMid, 140, 0.20f, PlatformerView.MidLayerY);
        this.DrawLayer(c, this.bgNear, 320, 0.30f, -1);
        PlatformerPaint.Fill(c, 0, PlatformerLevel.GroundY, w, h - PlatformerLevel.GroundY,
            PlatformerPalette.Abyss);
        // 舞台上摆三个位图主角（菜单也看得见美术）：朝向帧取"朝右"那一帧。
        if (this.playerKey != "") {
            PlatformerPaint.BlitSrc(c, this.playerKey, 120, PlatformerLevel.GroundY - 50,
                PlatformerPlayer.W, PlatformerPlayer.H,
                PlatformerFacing.PlayerSrcX(true), 0,
                PlatformerFacing.PlayerFrameW, PlatformerFacing.PlayerFrameH);
        }
        if (this.droneKey != "") {
            PlatformerPaint.BlitSrc(c, this.droneKey, 210, PlatformerLevel.GroundY - 38,
                PlatformerEnemy.W, PlatformerEnemy.H,
                PlatformerFacing.DroneSrcX(true), 0,
                PlatformerFacing.DroneFrameW, PlatformerFacing.DroneFrameH);
        }
        if (this.shardKey != "") {
            PlatformerPaint.Blit(c, this.shardKey, 300, PlatformerLevel.GroundY - 42, 28, 36);
        }
        PlatformerPaint.TextCentered(c, "跃 迁 山 谷", w / 2, 74, w, 56, PlatformerPalette.Amber);
        PlatformerPaint.TextCentered(c, "PLATFORMER · 横版重力跳跃 · 三关通关",
            w / 2, 136, w, 18, PlatformerPalette.Slate);
        // 存档统计（累计数据在菜单里能看见）。
        string stat = "累计通关 " + Convert.ToString(shell.Clears())
            + "   最远关卡 " + Convert.ToString(shell.Level())
            + "   最佳单关 " + PlatformerView.Sec((float)shell.BestTime()) + "s"
            + "   总分 " + Convert.ToString(shell.Score())
            + "   局数 " + Convert.ToString(shell.Runs());
        PlatformerPaint.TextCentered(c, stat, w / 2, 176, w, 17, PlatformerPalette.Parchment);
        PlatformerPaint.TextCentered(c, "A/D 移动 · 空格跳跃（空中再按一次 = 二段跳）· 踩扁巡逻兵 · 踩到旗子过关",
            w / 2, h - 70, w, 15, PlatformerPalette.Mist);
    }

    // ---- 结算 ---------------------------------------------------------

    public void DrawResult(Canvas c, PlatformerGame g, int w, int h, GameShell shell) {
        PlatformerPaint.Fill(c, 0, 0, w, h, PlatformerPalette.Scrim);
        int px = w / 2 - 280;
        int py = h / 2 - 190;
        int pw = 560;
        int ph = 380;
        if (this.boardKey != "") {
            PlatformerPaint.NineSlice(c, this.boardKey, px, py, pw, ph,
                PlatformerView.BoardCorner);
        } else {
            PlatformerPaint.FillRound(c, px, py, pw, ph, 12, PlatformerPalette.PanelFill);
            PlatformerPaint.Round(c, px, py, pw, ph, 12, PlatformerPalette.PanelEdge, 2);
        }
        bool won = g.clears >= PlatformerGame.LevelCount;
        string title = won ? "全部通关！" : "本局结束";
        PlatformerPaint.TextCentered(c, title, px + pw / 2, py + 22, pw, 32, PlatformerPalette.Amber);
        PlatformerPaint.TextCentered(c, "通关到第 " + Convert.ToString(g.levelIndex + 1) + " 关 · 共 "
            + Convert.ToString(g.clears) + " 关", px + pw / 2, py + 62, pw, 16, PlatformerPalette.Parchment);
        int ty = py + 100;
        string[] rows = new string[] {
            "总用时 " + PlatformerView.Sec(g.totalTimeMs) + " 秒",
            "晶片 " + Convert.ToString(g.coins) + " 枚    死亡 " + Convert.ToString(g.deaths) + " 次",
            "本局得分 " + Convert.ToString(g.score),
            "累计通关 " + Convert.ToString(shell.Clears()) + " 关    累计总分 " + Convert.ToString(shell.Score()),
            "最远关卡 第 " + Convert.ToString(shell.Level()) + " 关    最佳单关 "
                + PlatformerView.Sec((float)shell.BestTime()) + " 秒"
        };
        for (int i = 0; i < rows.Length; i = i + 1) {
            PlatformerPaint.TextCentered(c, rows[i], px + pw / 2, ty, pw, 17, PlatformerPalette.Slate);
            ty = ty + 28;
        }
    }

    // ---- 按钮 ---------------------------------------------------------

    public void DrawButton(Canvas c, string label, int x, int y, int w, int h,
                           bool hover, bool primary) {
        // 美术底板（九宫格）：常态 / 悬停 / 主按钮三张。
        string key = "";
        if (primary) { key = this.buttonPrimaryKey; }
        else if (hover) { key = this.buttonHoverKey; }
        else { key = this.buttonKey; }
        int text = primary ? PlatformerPalette.TextInk : PlatformerPalette.ButtonText;
        if (key != "") {
            PlatformerPaint.NineSlice(c, key, x, y, w, h, PlatformerView.ButtonCorner);
        } else {
            // 没有美术底板时的兜底：纯色圆角矩形。
            int bg = primary ? PlatformerPalette.ButtonPrimary : PlatformerPalette.ButtonFace;
            if (hover) {
                bg = primary ? PlatformerPalette.ButtonPrimaryHover : PlatformerPalette.ButtonFaceHover;
            }
            PlatformerPaint.FillRound(c, x, y, w, h, 8, bg);
            PlatformerPaint.Round(c, x, y, w, h, 8, PlatformerPalette.ButtonEdge, 2);
        }
        if (hover && primary) {
            PlatformerPaint.Round(c, x, y, w, h, 8, PlatformerPalette.AmberGlow, 2);
        }
        PlatformerPaint.TextCentered(c, label, x + w / 2, y + (h - 20) / 2, w, 19, text);
    }
}
