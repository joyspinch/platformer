using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Game.Foundation.Gui;
using Game.Kit;

// 一个可点的按钮。
public class PlatformerButton {
    public string label;
    public string action;
    public int x;
    public int y;
    public int w;
    public int h;
    public bool primary;

    public PlatformerButton(string label, string action, int x, int y, int w, int h, bool primary) {
        this.label = label;
        this.action = action;
        this.x = x;
        this.y = y;
        this.w = w;
        this.h = h;
        this.primary = primary;
    }
}

// 跃迁山谷 · PLATFORMER 入口：GuiHost 跑主循环。
//
// 画面用 Canvas 直绘（自绘游戏），设置浮层用标准库控件挂在 HUD 层上——
// 两者各司其职：游戏画面要贴图，设置要标准控件。
//
// 环境变量：
//   PLATFORMER_SMOKE=1         跑满 PLATFORMER_FRAMES 帧后自行退出
//   PLATFORMER_FRAMES=<n>      冒烟帧数（默认 90）
//   PLATFORMER_DEMO=1          演示模式：跳过菜单直接进关卡并自动操作
//   PLATFORMER_CAPTURE=<path>  指定帧把画布写成 .zpx 帧文件
//   PLATFORMER_SAVE=<dir>      存档目录（测试脚本用临时目录）
public class PlatformerApp : IGuiHostLoop {
    public GuiHost host;
    public GameShell shell;
    public PlatformerGame game;
    public PlatformerView view;
    public PlatformerSnd snd;
    public PlatformerFx fx;
    public List<PlatformerButton> buttons;
    public int frames;
    public bool smokeMode;
    public int smokeFrames;
    public string capturePath;
    public int captureFrame;
    bool finished;

    public PlatformerApp() {
        this.buttons = new List<PlatformerButton>();
        this.shell = new GameShell();
        this.game = new PlatformerGame(this.shell);
        this.view = new PlatformerView();
        this.snd = new PlatformerSnd();
        this.fx = new PlatformerFx();
        this.smokeMode = Environment.GetEnvironmentVariable("PLATFORMER_SMOKE") == "1";
        this.smokeFrames = 90;
        string framesEnv = Environment.GetEnvironmentVariable("PLATFORMER_FRAMES");
        if (framesEnv != "") { this.smokeFrames = Convert.ToInt32(framesEnv); }
        this.capturePath = Environment.GetEnvironmentVariable("PLATFORMER_CAPTURE");
        this.captureFrame = 120;
        string capEnv = Environment.GetEnvironmentVariable("PLATFORMER_CAPTURE_FRAME");
        if (capEnv != "") { this.captureFrame = Convert.ToInt32(capEnv); }
        this.game.demoMode = Environment.GetEnvironmentVariable("PLATFORMER_DEMO") == "1";
        this.view.LoadAssets();
    }

    static void Main() {
        PlatformerApp app = new PlatformerApp();
        GuiHost host = new GuiHost("跃迁山谷 · PLATFORMER", 1280, 720, 16);
        host.Run(app);
    }

    // ----- IGuiHostLoop ---------------------------------------------------

    public void Start(GuiHost h) {
        this.host = h;
        // 皮肤包（跃迁山谷风）：必须在默认皮肤之后应用，否则会被盖回去。
        // 皮肤目录在 exe 同级 skins/platformer/（构建时拷过去）。
        h.App().UseSkin("platformer");
        // 设置浮层挂到 HUD 层（标准库控件，盖在游戏画面之上）。
        h.Hud().Add(this.shell.Overlay().Root());
        // 无头冒烟与演示模式：跳过菜单直接进对局。
        if (this.smokeMode || this.game.demoMode) {
            this.game.StartRun();
        }
    }

    // kind：1=鼠标移动 2=鼠标按下 3=鼠标释放 4=键按下 5=键抬起。
    public void Event(GuiHost h, int kind, int keycode) {
        if (kind == 4) {
            if (keycode == 27) { this.shell.Overlay().Toggle(); return; }
            this.game.OnKeyDown(keycode);
            return;
        }
        if (kind == 5) { this.game.OnKeyUp(keycode); return; }
        if (kind != 3) { return; }
        this.OnClick(h.MouseX(), h.MouseY());
    }

    public void FixedUpdate(GuiHost h, int deltaMilliseconds) { }

    public void Update(GuiHost h, int deltaMilliseconds) {
        this.shell.Overlay().Tick();
        this.snd.Update(deltaMilliseconds);
        // 帧计数放在 Update：窗口不可见时宿主跳过渲染（Render 不跑），
        // 无头冒烟靠这个计数收尾。
        this.frames = this.frames + 1;
        if (this.smokeMode && this.frames >= this.smokeFrames) {
            this.Finish();
            h.RequestStop();
            return;
        }
        if (this.game.screen != 1) { return; }
        float dt = (float)deltaMilliseconds / 1000.0f;
        if (dt > 0.05f) { dt = 0.05f; }
        if (dt < 0.0f) { dt = 0.0f; }
        this.fx.Update(dt);
        this.game.Update(dt);
        this.DrainEvents();
    }

    public void Render(GuiHost h, Canvas c, double alpha) {
        int w = h.StageWidth();
        int hh = h.StageHeight();
        this.buttons.Clear();
        if (this.game.screen == 0) {
            this.view.DrawMenu(c, w, hh, this.shell);
            this.buttons.Add(new PlatformerButton("开始游戏", "start",
                w / 2 - 90, hh / 2 + 30, 180, 48, true));
            this.buttons.Add(new PlatformerButton("设置", "settings",
                w - 108, 6, 88, 34, false));
        } else {
            this.view.DrawGame(c, this.game, w, hh, this.fx);
            if (this.game.screen == 2) {
                this.view.DrawResult(c, this.game, w, hh, this.shell);
                this.buttons.Add(new PlatformerButton("再来一局", "restart",
                    w / 2 - 200, hh / 2 + 130, 180, 46, true));
                this.buttons.Add(new PlatformerButton("回到主菜单", "menu",
                    w / 2 + 20, hh / 2 + 130, 180, 46, false));
            }
            this.buttons.Add(new PlatformerButton("设置", "settings",
                w - 108, 6, 88, 34, false));
        }
        for (int i = 0; i < this.buttons.Count; i = i + 1) {
            PlatformerButton b = this.buttons[i];
            bool hover = this.host != null
                && this.host.MouseX() >= b.x && this.host.MouseX() < b.x + b.w
                && this.host.MouseY() >= b.y && this.host.MouseY() < b.y + b.h;
            this.view.DrawButton(c, b.label, b.x, b.y, b.w, b.h, hover, b.primary);
        }
        // 设置浮层是 HUD 控件：宿主每帧只"画"HUD、不给 HUD 控件排版，
        // 浮层根得先测量再按画布尺寸排一次，内容盒（card）才有尺寸、
        // 才画得出来（否则整层是空的——Esc 打开等于没打开）。
        // 放在本帧画面画完之后：测量会动到画布的样式状态，不能插在
        // 画面绘制中间。
        if (this.shell.Overlay().IsOpen() && h.App() != null) {
            App app = h.App();
            Control overlayRoot = this.shell.Overlay().Root();
            int top = app.ContentTop();
            overlayRoot.MeasureTree(app);
            overlayRoot.Arrange(0, top, c.Width(), c.Height() - top);
        }
        if (this.capturePath != "" && this.frames == this.captureFrame) {
            c.WritePixels(this.capturePath, 0, 0, c.Width(), c.Height());
            Console.WriteLine("PLATFORMER_CAPTURE " + Convert.ToString(c.Width())
                + "x" + Convert.ToString(c.Height()));
        }
    }

    public void Stop(GuiHost h) {
        this.Finish();
    }

    // 收尾：成绩落盘 + 打印读回值（测试脚本靠这行验证"跑两遍读得到"）。
    void Finish() {
        if (this.finished) { return; }
        this.finished = true;
        this.game.FlushSave();
        this.shell.Save();
        Console.WriteLine("PLATFORMER_SAVE level=" + Convert.ToString(this.shell.Level())
            + " clears=" + Convert.ToString(this.shell.Clears())
            + " bestTime=" + Convert.ToString(this.shell.BestTime())
            + " score=" + Convert.ToString(this.shell.Score())
            + " deaths=" + Convert.ToString(this.shell.Deaths())
            + " runs=" + Convert.ToString(this.shell.Runs()));
        if (this.smokeMode) {
            Console.WriteLine("PLATFORMER_SMOKE_OK frames=" + Convert.ToString(this.frames));
        }
        Console.WriteLine("PLATFORMER_SFX loaded=" + Convert.ToString(this.snd.loaded)
            + " assets=" + Convert.ToString(this.view.assetsReady));
    }

    // 把本帧的玩法事件转成音效与画面特效。
    void DrainEvents() {
        if (this.game.events.Count == 0) { return; }
        bool sound = this.shell.Sound();
        PlatformerPlayer p = this.game.player;
        for (int i = 0; i < this.game.events.Count; i = i + 1) {
            string ev = this.game.events[i];
            if (sound) { this.snd.Play(ev); }
            // 落地扬起尘土、起跳踢起一小片。
            if (ev == "land") {
                this.fx.SpawnDust(p.x + (float)PlatformerPlayer.W * 0.5f,
                    p.y + (float)PlatformerPlayer.H, 7, PlatformerPalette.Dust, 1.0f);
            } else if (ev == "jump") {
                this.fx.SpawnDust(p.x + (float)PlatformerPlayer.W * 0.5f,
                    p.y + (float)PlatformerPlayer.H, 4, PlatformerPalette.Dust, 0.6f);
            }
        }
        this.game.events.Clear();
    }

    // ----- 点击 -----------------------------------------------------------

    void OnClick(int mx, int my) {
        if (this.shell.Overlay().IsOpen()) { return; }
        for (int i = 0; i < this.buttons.Count; i = i + 1) {
            PlatformerButton b = this.buttons[i];
            if (mx < b.x || mx >= b.x + b.w || my < b.y || my >= b.y + b.h) { continue; }
            this.OnButton(b);
            return;
        }
    }

    void OnButton(PlatformerButton b) {
        if (b.action == "start" || b.action == "restart") {
            this.game.StartRun();
            return;
        }
        if (b.action == "menu") {
            this.game.screen = 0;
            return;
        }
        if (b.action == "settings") {
            this.shell.Overlay().Toggle();
            return;
        }
    }
}
